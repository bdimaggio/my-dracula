{
    "name": "my-dracula",
    "version": "1.0.0",
    "displayName": "Dracula Theme, Customized",
    "description": "🦇",
    "publisher": "bdimaggio",
    "license": "MIT",
    "scripts": {
        "build": "node ./scripts/build.js",
        "lint": "node ./scripts/lint.js",
        "package": "vsce package -o ./bin/dracula.vsix",
        "vscode:prepublish": "npm run build",
        "vsce-publish": "vsce publish"
    },
    "maintainers": [
        "Derek Sifford",
        "Lucas de França (luxonauta)",
        "Zeno Rocha"
    ],
    "contributors": [
        "Krzysztof Wisznarewski",
        "Daniel Ramos",
        "Eric Jackson",
        "Elliott Pogue",
        "Ajit Singh",
        "Teddy Bradford"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bdimaggio/my-dracula.git"
    },
    "bugs": {
        "url": "https://github.com/bdimaggio/my-dracula/issues"
    },
    "engines": {
        "vscode": "^1.13.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "dracula",
        "dark",
        "theme",
        "color-theme"
    ],
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#3c4557",
        "theme": "dark"
    },
    "contributes": {
        "themes": [
            {
                "label": "Customized Dracula Theme",
                "uiTheme": "vs-dark",
                "path": "./theme/dracula.json"
            }
        ]
    },
    "devDependencies": {
        "js-yaml": "^4.3.2",
        "prettier": "^3.0.0",
        "tinycolor2": "^1.6.0",
        "vsce": "^2.15.0"
    }
}
